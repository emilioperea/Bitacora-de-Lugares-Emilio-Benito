<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Botones" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/primario</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/texto_normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="BotonesSecundarios" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">@dimen/texto_normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/borde</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Etiquetas" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">@dimen/texto_chico</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Campos" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="android:textSize">@dimen/texto_normal</item>
    </style>
</resources>